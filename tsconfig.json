{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "es6",
    "module": "es6",
    "moduleResolution": "node",
    "jsx": "react",
    "baseUrl": ".",
    "noImplicitAny":false,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "components": ["components"],
      "@/*": ["./src/*"],
    },
  "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/**/__tests__"]
}
