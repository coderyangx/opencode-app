{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-app",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://bfwtpofxsbiiepavfjcc.supabase.co",
    "SUPABASE_KEY": "sb_publishable_Y-Ir3n8A5tWklLkb78woIA_djtLeMGX",
    "OPENAI_BASE_URL": "https://api.codeturbo.ai/v1",
    "OPENAI_API_KEY": "sk-b0376b7c81cf352ad3ec997d721e5a7174f302b6479d0a09fc2609d095238837",
    "OPENAI_MODEL_ID": "gpt-5.4-mini",
    "FRONTEND_URL": "https://opencode-app.workers.dev"
  }
  // 敏感变量通过 wrangler secret 命令写入：
  // wrangler secret put SUPABASE_URL
  // wrangler secret put SUPABASE_KEY
  // wrangler secret put OPENAI_BASE_URL
  // wrangler secret put OPENAI_API_KEY
}
