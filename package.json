{
  "name": "data-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:widgets": "yarn workspace widgets dev",
    "dev:server": "yarn workspace server dev",
    "dev": "concurrently -n server,widgets -c blue,green \"yarn dev:server\" \"yarn dev:widgets\"",
    "build:widgets": "yarn workspace widgets build",
    "build:server": "yarn workspace server build",
    "build": "yarn build:server && yarn build:widgets",
    "start": "yarn workspace server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
